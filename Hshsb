-- =============================================================================
-- DETECCIÓN FÍSICA (WALLCHECK MEDIANTE RAYCASTING)
-- =============================================================================
local function IsVisible(targetCharacter)
    if not AimbotSettings.WallCheck then return true end
    
    local targetHead = targetCharacter:FindFirstChild("Head")
    if not targetHead then return false end

    local rayOrigin = Camera.CFrame.Position
    local rayDirection = (targetHead.Position - rayOrigin)
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local result = game.Workspace:Raycast(rayOrigin, rayDirection, raycastParams)

    if result and result.Instance:IsDescendantOf(targetCharacter) then
        return true
    end
    return false
end

